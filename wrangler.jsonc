{
  "name": "adcoolindia",
  "main": "./worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/styles.css",
      "!/app.js",
      "!/favicon.ico",
      "!/site.webmanifest",
      "!/robots.txt",
      "!/sitemap.xml"
    ],
    "not_found_handling": "404-page"
  }
}
